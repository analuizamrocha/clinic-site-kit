    "@testing-library/react": "^16.1.0",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
